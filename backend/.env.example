NODE_ENV="development"
PORT="3000"
CORS_ORIGIN="http://localhost:5173"

# Supabase + Prisma
# Persistent local/backend app traffic through Supabase shared pooler session mode:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
#
# Serverless/transaction-pooler app traffic, if you deploy this backend that way:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Prisma direct URL for migrations/introspection. Prefer the direct Supabase host when your network supports it:
# DIRECT_URL="postgresql://postgres:[DATABASE_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
# If direct IPv6 is unavailable locally, use the session pooler on port 5432:
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DATABASE_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
DATABASE_URL=""
DIRECT_URL=""

OPENAI_API_KEY=""
OPENAI_MODEL=""
OPENAI_VECTOR_STORE_ID=""
JWT_SECRET=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_MANAGER_CHAT_ID=""
TELEGRAM_WEBHOOK_URL=""
TELEGRAM_ALLOWED_USER_IDS=""

# Runtime mode
# Production Render should use true: Render runs API + Telegram bot.
# Local development should use false: Localhost runs API only and does not conflict with Render.
# Telegram polling/getUpdates allows only one active process per bot token.
ENABLE_TELEGRAM_BOT=false

ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""
